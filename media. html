<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MEDIAX - Media Viewer</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #0b1020;
  color: white;
}

header {
  padding: 20px;
  text-align: center;
  background: #111a30;
  border-bottom: 1px solid #26334e;
}

.logo {
  font-size: 28px;
  font-weight: bold;
  color: #65b9ff;
}

.container {
  max-width: 700px;
  margin: 25px auto;
  padding: 16px;
}

.card {
  background: #151f36;
  padding: 22px;
  border-radius: 16px;
  border: 1px solid #293954;
  margin-bottom: 20px;
}

h1, h2 {
  margin-top: 0;
}

.description {
  color: #b8c4d9;
  line-height: 1.6;
}

label {
  display: block;
  margin: 18px 0 8px;
}

input {
  width: 100%;
  padding: 14px;
  border-radius: 9px;
  border: 1px solid #40516f;
  background: #0b1020;
  color: white;
  font-size: 15px;
}

button, .source-button {
  display: block;
  width: 100%;
  padding: 14px;
  border: 0;
  border-radius: 9px;
  background: #1688ff;
  color: white;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
}

button:disabled {
  opacity: .6;
  cursor: not-allowed;
}

.main-button {
  margin-top: 14px;
}

.download-button {
  margin-top: 12px;
  background: #159b61;
}

.source-button {
  display: none;
  margin-top: 12px;
  background: #40516f;
}

#status {
  margin-top: 16px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.preview {
  display: none;
  margin-top: 20px;
  padding: 12px;
  border-radius: 12px;
  background: #0b1020;
}

.preview video {
  width: 100%;
  max-height: 430px;
  object-fit: contain;
  border-radius: 8px;
  background: black;
}

.note {
  color: #aebbd0;
  font-size: 12px;
  line-height: 1.7;
}

.back {
  display: block;
  text-align: center;
  color: #75bcff;
  text-decoration: none;
  margin: 20px;
}

@media(max-width: 450px) {
  .container {
    padding: 12px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">MEDIAX</div>
  <div>Media Viewer</div>
</header>

<main class="container">

<section class="card">

  <h1>Check Your Media Link</h1>

  <p class="description">
    Paste a media URL, check the link and preview
    supported direct video files.
  </p>

  <form id="mediaForm">

    <label for="mediaUrl">Paste Media URL</label>

    <input
      id="mediaUrl"
      type="url"
      placeholder="https://example.com/video.mp4"
      maxlength="2048"
      required
    >

    <button
      class="main-button"
      id="checkButton"
      type="submit"
    >
      Check Link
    </button>

  </form>

  <div id="status" role="status" aria-live="polite"></div>

  <div class="preview" id="preview"></div>

  <button
    id="downloadButton"
    class="download-button"
    type="button"
    hidden
  >
    Download Video
  </button>

  <a
    id="sourceButton"
    class="source-button"
    href="#"
    target="_blank"
    rel="noopener noreferrer"
  >
    Open Video Source
  </a>

</section>

<section class="card">

  <h2>Supported Platforms</h2>

  <p class="description">
    YouTube, Instagram, Facebook, WhatsApp and other websites.
  </p>

  <p class="note">
    Direct video files such as MP4, WebM, MOV and M4V
    may be previewed if the source permits browser access.

    Downloading depends on source permissions and browser
    access. The Download button cannot guarantee that every
    external video can be downloaded.

    MEDIAX does not bypass login restrictions, privacy
    controls or DRM.

    Only use videos you own or have permission to access.
  </p>

</section>

<a class="back" href="./index.html">← Back to Home</a>

</main>

<script>
const API_URL = "https://mediax-api.onrender.com";

const form = document.getElementById("mediaForm");
const input = document.getElementById("mediaUrl");
const button = document.getElementById("checkButton");
const statusBox = document.getElementById("status");
const preview = document.getElementById("preview");
const sourceButton = document.getElementById("sourceButton");
const downloadButton = document.getElementById("downloadButton");

let currentVideoUrl = "";
let currentVideoName = "mediax-video.mp4";

function showStatus(message, success = false) {
  statusBox.textContent = message;
  statusBox.style.color = success ? "#6ee7a8" : "#ff9b9b";
}

function clearResults() {
  preview.replaceChildren();
  preview.style.display = "none";

  sourceButton.style.display = "none";
  sourceButton.href = "#";

  downloadButton.hidden = true;

  currentVideoUrl = "";
  currentVideoName = "mediax-video.mp4";
}

function getFileName(url) {
  try {
    const parsed = new URL(url);
    let name = parsed.pathname.split("/").pop();

    name = decodeURIComponent(name || "mediax-video.mp4");

    name = name.replace(/[^a-zA-Z0-9._-]/g, "_");

    if (!name || name === ".") {
      return "mediax-video.mp4";
    }

    return name;
  } catch {
    return "mediax-video.mp4";
  }
}

async function postData(endpoint, url) {
  const response = await fetch(API_URL + endpoint, {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({ url })
  });

  let data;

  try {
    data = await response.json();
  } catch {
    throw new Error("Backend returned an invalid response.");
  }

  if (!response.ok || !data.success) {
    throw new Error(data.message || "Request failed.");
  }

  return data;
}

function showVideo(url) {
  const heading = document.createElement("h3");
  heading.textContent = "Video Preview";

  const video = document.createElement("video");

  video.src = url;
  video.controls = true;
  video.preload = "metadata";
  video.playsInline = true;

  video.addEventListener("error", () => {
    showStatus(
      "Video found, but the source does not allow browser preview."
    );
    downloadButton.hidden = true;
  });

  preview.append(heading, video);
  preview.style.display = "block";
}

async function downloadVideo() {
  if (!currentVideoUrl) {
    showStatus("Please check a video link first.");
    return;
  }

  downloadButton.disabled = true;
  downloadButton.textContent = "Preparing Download...";

  try {
    const response = await fetch(currentVideoUrl, {
      method: "GET",
      mode: "cors",
      credentials: "omit"
    });

    if (!response.ok) {
      throw new Error("The source did not provide the video file.");
    }

    const contentType = (
      response.headers.get("content-type") || ""
    ).toLowerCase();

    if (
      contentType &&
      !contentType.startsWith("video/") &&
      !contentType.includes("application/octet-stream")
    ) {
      throw new Error("The source did not return a video file.");
    }

    const blob = await response.blob();

    if (!blob.size) {
      throw new Error("The video file is empty.");
    }

    const blobUrl = URL.createObjectURL(blob);

    const link = document.createElement("a");
    link.href = blobUrl;
    link.download = currentVideoName;

    document.body.appendChild(link);
    link.click();
    link.remove();

    setTimeout(() => {
      URL.revokeObjectURL(blobUrl);
    }, 60000);

    showStatus("Download started successfully ✅", true);

  } catch (error) {
    showStatus(
      "Direct download is blocked by the source or browser. Use Open Video Source if the website provides a permitted download option."
    );
  } finally {
    downloadButton.disabled = false;
    downloadButton.textContent = "Download Video";
  }
}

downloadButton.addEventListener("click", downloadVideo);

form.addEventListener("submit", async event => {
  event.preventDefault();

  clearResults();

  button.disabled = true;
  button.textContent = "Checking...";

  try {
    const enteredUrl = input.value.trim();
    const parsedUrl = new URL(enteredUrl);

    if (parsedUrl.protocol !== "https:") {
      throw new Error("Please enter a secure HTTPS link.");
    }

    if (parsedUrl.username || parsedUrl.password) {
      throw new Error("This URL format is not supported.");
    }

    showStatus("Checking your link...", true);

    const platformData = await postData(
      "/api/check",
      parsedUrl.href
    );

    if (platformData.platform !== "Other Website") {
      showStatus(
        platformData.platform +
        " detected successfully ✅. Use the platform's permitted download options. MEDIAX cannot directly download every social media link.",
        true
      );

      return;
    }

    showStatus(
      "Website detected. Checking for a direct media file...",
      true
    );

    const mediaData = await postData(
      "/api/media/inspect",
      parsedUrl.href
    );

    if (mediaData.mediaType !== "video") {
      throw new Error("This link is not a supported video file.");
    }

    const safeUrl = new URL(
      mediaData.previewUrl || parsedUrl.href
    );

    if (safeUrl.protocol !== "https:") {
      throw new Error("Only HTTPS video links are supported.");
    }

    currentVideoUrl = safeUrl.href;
    currentVideoName = getFileName(safeUrl.href);

    showVideo(currentVideoUrl);

    sourceButton.href = currentVideoUrl;
    sourceButton.style.display = "block";

    downloadButton.hidden = false;

    showStatus(
      "Direct video file recognized ✅. Preview is ready. Download availability depends on the source.",
      true
    );

  } catch (error) {
    showStatus(
      error.message || "Unable to check this link."
    );
  } finally {
    button.disabled = false;
    button.textContent = "Check Link";
  }
});
</script>

</body>
</html>
