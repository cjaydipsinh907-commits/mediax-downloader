<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MEDIAX - Media Viewer</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #0b1020;
  color: white;
}

header {
  padding: 20px;
  text-align: center;
  background: #111a30;
  border-bottom: 1px solid #26334e;
}

.logo {
  font-size: 28px;
  font-weight: bold;
  color: #65b9ff;
}

.container {
  max-width: 700px;
  margin: 25px auto;
  padding: 16px;
}

.card {
  background: #151f36;
  padding: 22px;
  border-radius: 16px;
  border: 1px solid #293954;
  margin-bottom: 20px;
}

h1, h2 {
  margin-top: 0;
}

.description {
  color: #b8c4d9;
  line-height: 1.6;
}

label {
  display: block;
  margin: 18px 0 8px;
}

input {
  width: 100%;
  padding: 14px;
  border-radius: 9px;
  border: 1px solid #40516f;
  background: #0b1020;
  color: white;
  font-size: 15px;
}

button, .source-button {
  display: block;
  width: 100%;
  padding: 14px;
  border: 0;
  border-radius: 9px;
  background: #1688ff;
  color: white;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
}

button:disabled {
  opacity: .6;
  cursor: not-allowed;
}

.main-button {
  margin-top: 14px;
}

.source-button {
  display: none;
  margin-top: 12px;
  background: #159b61;
}

#status {
  margin-top: 16px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.preview {
  display: none;
  margin-top: 20px;
  padding: 12px;
  border-radius: 12px;
  background: #0b1020;
}

.preview video {
  width: 100%;
  max-height: 430px;
  object-fit: contain;
  border-radius: 8px;
  background: black;
}

.note {
  color: #aebbd0;
  font-size: 12px;
  line-height: 1.7;
}

.back {
  display: block;
  text-align: center;
  color: #75bcff;
  text-decoration: none;
  margin: 20px;
}

@media(max-width: 450px) {
  .container {
    padding: 12px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">MEDIAX</div>
  <div>Media Viewer</div>
</header>

<main class="container">

<section class="card">

  <h1>Check Your Media Link</h1>

  <p class="description">
    Paste a media link to identify its platform.
    Direct video file links can also be previewed.
  </p>

  <form id="mediaForm">

    <label for="mediaUrl">Paste Media URL</label>

    <input
      id="mediaUrl"
      type="url"
      placeholder="https://example.com/video.mp4"
      maxlength="2048"
      required
    >

    <button
      class="main-button"
      id="checkButton"
      type="submit"
    >
      Check Link
    </button>

  </form>

  <div id="status" role="status" aria-live="polite"></div>

  <div class="preview" id="preview"></div>

  <a
    id="sourceButton"
    class="source-button"
    href="#"
    target="_blank"
    rel="noopener noreferrer"
  >
    Open Video Source
  </a>

</section>

<section class="card">

  <h2>Supported Platforms</h2>

  <p class="description">
    YouTube, Instagram, Facebook, WhatsApp and other websites.
  </p>

  <p class="note">
    Platform detection does not guarantee video downloading.

    Direct video files such as MP4, WebM, MOV and M4V
    may be previewed if the source permits browser access.

    Some platforms restrict video access and downloads.
    MEDIAX does not bypass login restrictions, privacy
    controls or DRM.

    Only use videos you own or have permission to access.
  </p>

</section>

<a class="back" href="./index.html">← Back to Home</a>

</main>

<script>
const API_URL = "https://mediax-api.onrender.com";

const form = document.getElementById("mediaForm");
const input = document.getElementById("mediaUrl");
const button = document.getElementById("checkButton");
const statusBox = document.getElementById("status");
const preview = document.getElementById("preview");
const sourceButton = document.getElementById("sourceButton");

function showStatus(message, success = false) {
  statusBox.textContent = message;
  statusBox.style.color = success ? "#6ee7a8" : "#ff9b9b";
}

function clearResults() {
  preview.replaceChildren();
  preview.style.display = "none";
  sourceButton.style.display = "none";
  sourceButton.href = "#";
}

async function postData(endpoint, url) {
  const response = await fetch(API_URL + endpoint, {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({ url })
  });

  const data = await response.json();

  if (!response.ok || !data.success) {
    throw new Error(data.message || "Request failed.");
  }

  return data;
}

function showVideo(url) {
  const heading = document.createElement("h3");
  heading.textContent = "Video Preview";

  const video = document.createElement("video");
  video.src = url;
  video.controls = true;
  video.preload = "metadata";
  video.playsInline = true;

  video.addEventListener("error", () => {
    showStatus(
      "Video recognized, but the source does not allow browser preview."
    );
  });

  preview.append(heading, video);
  preview.style.display = "block";
}

form.addEventListener("submit", async event => {
  event.preventDefault();

  clearResults();

  button.disabled = true;
  button.textContent = "Checking...";

  try {
    const enteredUrl = input.value.trim();
    const parsedUrl = new URL(enteredUrl);

    if (parsedUrl.protocol !== "https:") {
      throw new Error("Please enter a secure HTTPS link.");
    }

    if (parsedUrl.username || parsedUrl.password) {
      throw new Error("This URL format is not supported.");
    }

    showStatus("Checking platform...", true);

    const platformData = await postData(
      "/api/check",
      parsedUrl.href
    );

    showStatus(
      "Platform detected: " +
      platformData.platform +
      " | " +
      platformData.contentType +
      " ✅",
      true
    );

    if (platformData.platform !== "Other Website") {
      showStatus(
        platformData.platform +
        " detected successfully ✅. Direct downloading is not available for this link. Use the platform's permitted options.",
        true
      );

      return;
    }

    showStatus(
      "Other Website detected. Checking for a direct video file...",
      true
    );

    const mediaData = await postData(
      "/api/media/inspect",
      parsedUrl.href
    );

    if (mediaData.mediaType !== "video") {
      throw new Error("This link is not a supported video file.");
    }

    const safeUrl = new URL(mediaData.previewUrl);

    if (safeUrl.protocol !== "https:") {
      throw new Error("Only HTTPS video links are supported.");
    }

    showVideo(safeUrl.href);

    sourceButton.href = safeUrl.href;
    sourceButton.style.display = "block";

    showStatus(
      "Direct video file recognized ✅. You can preview or open the source. Actual downloading depends on the source website.",
      true
    );

  } catch (error) {
    showStatus(
      error.message || "Unable to check this link."
    );
  } finally {
    button.disabled = false;
    button.textContent = "Check Link";
  }
});
</script>

</body>
</html>
