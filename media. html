  display: none !important;
}

@media(max-width: 450px) {
  .container {
    padding: 12px;
  }

  .card {
    padding: 17px;
  }
}

@media(prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
  }
}
</style></head><body><header>
  <div class="logo">MEDIAX</div>
  <div>Media Viewer</div>
</header><main class="container"><section class="card">  <h1>Check Your Media Link</h1>  <p class="description">
    Paste a media URL, check the link and preview
    supported direct video files.
  </p>  <form id="mediaForm"><label for="mediaUrl">Paste Media URL</label>

<input
  id="mediaUrl"
  type="url"
  placeholder="https://example.com/video.mp4"
  maxlength="2048"
  required
>

<button
  class="main-button"
  id="checkButton"
  type="submit"
>
  Check Link
</button>

  </form>  <div id="status" role="status" aria-live="polite"></div>  <div class="preview" id="preview"></div>  <div class="file-info" id="fileInfo" hidden></div>  <div class="progress-container" id="progressContainer">
    <div class="progress-track">
      <div class="progress-bar" id="progressBar"></div>
    </div>
    <div class="progress-text" id="progressText">
      Preparing download...
    </div>
  </div><button
id="downloadButton"
