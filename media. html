Clear History

  </button></section><section class="card">  <h2>Supported Platforms</h2>  <p class="description">
    YouTube, Instagram, Facebook, WhatsApp and other websites.
  </p>  <p class="note">
    Direct video files such as MP4, WebM, MOV and M4V
    may be previewed if the source permits browser access.Downloading depends on source permissions and browser
access. MEDIAX does not bypass login restrictions,
privacy controls or DRM.

Only use videos you own or have permission to access.

  </p>  <p class="note">
    Downloads are limited to 200 MB per file in this
    browser-based version. Download history is stored
    locally on this device.
  </p></section><a class="back" href="./index.html">← Back to Home</a>

</main><script>
const API_URL = "https://mediax-api.onrender.com";
const MAX_DOWNLOAD_SIZE = 200 * 1024 * 1024;
const HISTORY_KEY = "mediax_download_history";

const form = document.getElementById("mediaForm");
const input = document.getElementById("mediaUrl");
const button = document.getElementById("checkButton");
const statusBox = document.getElementById("status");
const preview = document.getElementById("preview");
const fileInfo = document.getElementById("fileInfo");
const sourceButton = document.getElementById("sourceButton");
const downloadButton = document.getElementById("downloadButton");
const cancelButton = document.getElementById("cancelButton");
const progressContainer = document.getElementById("progressContainer");
const progressBar = document.getElementById("progressBar");
const progressText = document.getElementById("progressText");
const historyList = document.getElementById("historyList");
const clearHistoryButton = document.getElementById("clearHistoryButton");

let currentVideoUrl = "";
let currentVideoName = "mediax-video.mp4";
let currentVideo = null;
let downloadController = null;

function showStatus(message, success = false) {
  statusBox.textContent = message;
  statusBox.style.color = success ? "#6ee7a8" : "#ff9b9b";
}

function formatBytes(bytes) {
  if (!Number.isFinite(bytes) || bytes < 0) {
    return "Unknown";
  }

  if (bytes === 0) {
    return "0 Bytes";
  }

  const units = ["Bytes", "KB", "MB", "GB"];
  const index = Math.min(
    Math.floor(Math.log(bytes) / Math.log(1024)),
    units.length - 1
  );

  return (
    (bytes / Math.pow(1024, index)).toFixed(2) +
    " " +
    units[index]
  );
}

function formatDuration(seconds) {
  if (!Number.isFinite(seconds)) {
    return "Not available";
  }

  const minutes = Math.floor(seconds / 60);
  const remainingSeconds = Math.floor(seconds % 60);

  return (
    minutes +
    ":" +
    String(remainingSeconds).padStart(2, "0")
  );
}

function getHistory() {
  try {
    const history = JSON.parse(
      localStorage.getItem(HISTORY_KEY) || "[]"
    );

    return Array.isArray(history) ? history : [];
  } catch {
    return [];
  }
}

function saveHistory(name, size) {
  const history = getHistory();

  history.unshift({
    name,
    size: formatBytes(size),
    date: new Date().toLocaleString()
  });

  try {
    localStorage.setItem(
      HISTORY_KEY,
      JSON.stringify(history.slice(0, 10))
    );
  } catch {
    showStatus(
      "Download completed, but history could not be saved.",
      true
    );
  }

  displayHistory();
}

function displayHistory() {
  historyList.replaceChildren();

  const history = getHistory();

  if (!history.length) {
    const empty = document.createElement("p");
    empty.className = "note";
    empty.textContent = "No successful downloads yet.";
    historyList.appendChild(empty);
    return;
  }

  history.forEach(item => {
    const row = document.createElement("div");
    row.className = "history-item";

    const name = document.createElement("strong");
    name.textContent = item.name;

    const details = document.createElement("small");
    details.textContent =
      item.size + " · " + item.date;

    row.append(name, document.createElement("br"), details);
    historyList.appendChild(row);
  });
}

function clearHistory() {
  localStorage.removeItem(HISTORY_KEY);
  displayHistory();
  showStatus("Download history cleared.", true);
}

function resetProgress() {
  progressContainer.style.display = "none";
  progressBar.style.width = "0%";
  progressText.textContent = "Preparing download...";
}

function clearResults() {
  if (downloadController) {
    downloadController.abort();
    downloadController = null;
  }

  preview.replaceChildren();
  preview.style.display = "none";

  fileInfo.replaceChildren();
  fileInfo.hidden = true;

  sourceButton.style.display = "none";
  sourceButton.href = "#";

  downloadButton.hidden = true;
  downloadButton.disabled = false;

  cancelButton.hidden = true;

  resetProgress();

  currentVideoUrl = "";
  currentVideoName = "mediax-video.mp4";
  currentVideo = null;
}

function getFileName(url) {
  try {
    const parsed = new URL(url);
    let name = parsed.pathname.split("/").pop();

    name = decodeURIComponent(name || "mediax-video.mp4");
    name = name.replace(/[^a-zA-Z0-9._-]/g, "_");

    if (!name || name === ".") {
      return "mediax-video.mp4";
    }

    return name;
  } catch {
    return "mediax-video.mp4";
  }
}

async function postData(endpoint, url) {
  const response = await fetch(API_URL + endpoint, {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({ url })
  });

  let data;

  try {
    data = await response.json();
  } catch {
    throw new Error("Backend returned an invalid response.");
  }

  if (!response.ok || !data.success) {
    throw new Error(data.message || "Request failed.");
  }

  return data;
}

function addInfoRow(label, value) {
  const row = document.createElement("div");
  const strong = document.createElement("strong");

  strong.textContent = label + ": ";

  row.append(
    strong,
    document.createTextNode(value)
  );

  fileInfo.appendChild(row);
}

function showVideo(url) {
  const heading = document.createElement("h3");
  heading.textContent = "Video Preview";

  const video = document.createElement("video");

  video.src = url;
  video.controls = true;
  video.preload = "metadata";
  video.playsInline = true;

  currentVideo = video;

  video.addEventListener("loadedmetadata", () => {
    fileInfo.replaceChildren();

    addInfoRow("File name", currentVideoName);
    addInfoRow("Format", currentVideoName.split(".").pop().toUpperCase());
    addInfoRow("Duration", formatDuration(video.duration));
    addInfoRow(
      "Resolution",
      video.videoWidth + " × " + video.videoHeight
    );

    addInfoRow(
      "File size",
      "Available when the source provides it during download"
    );

    fileInfo.hidden = false;
  });

  video.addEventListener("error", () => {
    showStatus(
      "Video found, but the source does not allow browser preview."
    );

    downloadButton.hidden = true;
  });

  preview.append(heading, video);
  preview.style.display = "block";
}

function updateProgress(loaded, total) {
  if (total > 0) {
    const percent = Math.min(
      100,
      Math.round((loaded / total) * 100)
    );

    progressBar.style.width = percent + "%";

    progressText.textContent =
      percent +
      "% · " +
      formatBytes(loaded) +
      " / " +
      formatBytes(total);
  } else {
    progressBar.style.width = "100%";

    progressText.textContent =
      formatBytes(loaded) + " downloaded";
  }
}

async function downloadVideo() {
  if (!currentVideoUrl) {
    showStatus("Please check a video link first.");
    return;
  }

  downloadButton.disabled = true;
  cancelButton.hidden = false;
  progressContainer.style.display = "block";

  progressBar.style.width = "0%";
  progressText.textContent = "Connecting to source...";

  downloadController = new AbortController();

  try {
    const response = await fetch(currentVideoUrl, {
      method: "GET",
      mode: "cors",
      credentials: "omit",
      signal: downloadController.signal
    });

    if (!response.ok) {
      throw new Error("The source did not provide the video file.");
    }

    const contentType = (
      response.headers.get("content-type") || ""
    ).toLowerCase();

    if (
      contentType &&
      !contentType.startsWith("video/") &&
      !contentType.includes("application/octet-stream")
    ) {
      throw new Error("The source did not return a video file.");
    }

    const contentLength = Number(
      response.headers.get("content-length")
    );

    if (
      Number.isFinite(contentLength) &&
      contentLength > MAX_DOWNLOAD_SIZE
    ) {
      throw new Error("This file exceeds the 200 MB download limit.");
    }

    if (!response.body) {
      throw new Error("Streaming is not supported by this browser.");
    }

    const reader = response.body.getReader();
    const chunks = [];
    let loaded = 0;

    while (true) {
      const result = await reader.read();

      if (result.done) {
        break;
      }

      loaded += result.value.length;

      if (loaded > MAX_DOWNLOAD_SIZE) {
        await reader.cancel();
        throw new Error("This file exceeds the 200 MB download limit.");
      }

      chunks.push(result.value);

      updateProgress(
        loaded,
        Number.isFinite(contentLength) && contentLength > 0
          ? contentLength
          : 0
      );
    }

    if (!loaded) {
      throw new Error("The video file is empty.");
    }

    const blob = new Blob(chunks, {
      type: contentType || "application/octet-stream"
    });

    const blobUrl = URL.createObjectURL(blob);

    const link = document.createElement("a");
    link.href = blobUrl;
    link.download = currentVideoName;

    document.body.appendChild(link);
    link.click();
    link.remove();

    setTimeout(() => {
      URL.revokeObjectURL(blobUrl);
    }, 60000);

    saveHistory(currentVideoName, blob.size);

    progressBar.style.width = "100%";
    progressText.textContent =
      "Download prepared: " + formatBytes(blob.size);

    showStatus(
      "Download prepared successfully ✅ Check your browser downloads.",
      true
    );

  } catch (error) {
    if (error.name === "AbortError") {
      showStatus("Download cancelled.");
    } else {
      showStatus(
        error.message ||
        "Download failed. The source may block browser access."
      );
    }
  } finally {
    downloadController = null;
    downloadButton.disabled = false;
    cancelButton.hidden = true;
  }
}

function cancelDownload() {
  if (downloadController) {
    downloadController.abort();
  }
}

downloadButton.addEventListener("click", downloadVideo);
cancelButton.addEventListener("click", cancelDownload);
clearHistoryButton.addEventListener("click", clearHistory);

form.addEventListener("submit", async event => {
  event.preventDefault();

  clearResults();

  button.disabled = true;
  button.textContent = "Checking...";

  try {
    const enteredUrl = input.value.trim();
    const parsedUrl = new URL(enteredUrl);

    if (parsedUrl.protocol !== "https:") {
      throw new Error("Please enter a secure HTTPS link.");
    }

    if (parsedUrl.username || parsedUrl.password) {
      throw new Error("This URL format is not supported.");
    }

    showStatus("Checking your link...", true);

    const platformData = await postData(
      "/api/check",
      parsedUrl.href
    );

    if (platformData.platform !== "Other Website") {
      showStatus(
        platformData.platform +
        " detected successfully ✅. Use the platform's permitted download options. MEDIAX cannot directly download every social media link.",
        true
      );

      return;
    }

    showStatus(
      "Website detected. Checking for a direct media file...",
      true
    );

    const mediaData = await postData(
      "/api/media/inspect",
      parsedUrl.href
    );

    if (mediaData.mediaType !== "video") {
      throw new Error("This link is not a supported video file.");
    }

    const safeUrl = new URL(
      mediaData.previewUrl || parsedUrl.href
    );

    if (
      safeUrl.protocol !== "https:" ||
      safeUrl.username ||
      safeUrl.password
    ) {
      throw new Error("This video link is not supported.");
    }

    currentVideoUrl = safeUrl.href;
    currentVideoName = getFileName(safeUrl.href);

    showVideo(currentVideoUrl);

    sourceButton.href = currentVideoUrl;
    sourceButton.style.display = "block";

    downloadButton.hidden = false;

    showStatus(
      "Direct video file recognized ✅. Preview is ready. Download availability depends on the source.",
      true
    );

  } catch (error) {
    showStatus(
      error.message || "Unable to check this link."
    );
  } finally {
    button.disabled = false;
    button.textContent = "Check Link";
  }
});

displayHistory();
</script></body>
