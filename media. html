<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MEDIAX - Video Preview & Download</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #0b1020;
  color: white;
}

header {
  padding: 20px;
  text-align: center;
  background: #111a30;
  border-bottom: 1px solid #26334e;
}

.logo {
  font-size: 28px;
  font-weight: bold;
  color: #65b9ff;
}

.container {
  max-width: 700px;
  margin: 25px auto;
  padding: 16px;
}

.card {
  background: #151f36;
  padding: 22px;
  border-radius: 16px;
  border: 1px solid #293954;
  margin-bottom: 20px;
}

h1, h2 {
  margin-top: 0;
}

.description {
  color: #b8c4d9;
  line-height: 1.6;
}

label {
  display: block;
  margin: 18px 0 8px;
}

input {
  width: 100%;
  padding: 14px;
  border-radius: 9px;
  border: 1px solid #40516f;
  background: #0b1020;
  color: white;
  font-size: 15px;
}

button, .download-button {
  display: block;
  width: 100%;
  padding: 14px;
  border: 0;
  border-radius: 9px;
  background: #1688ff;
  color: white;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
}

button:disabled {
  opacity: .6;
  cursor: not-allowed;
}

.main-button {
  margin-top: 14px;
}

.download-button {
  display: none;
  margin-top: 12px;
  background: #159b61;
}

#status {
  margin-top: 16px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.preview {
  display: none;
  margin-top: 20px;
  padding: 12px;
  border-radius: 12px;
  background: #0b1020;
}

.preview video,
.preview img {
  width: 100%;
  max-height: 430px;
  object-fit: contain;
  border-radius: 8px;
  background: black;
}

.note {
  color: #aebbd0;
  font-size: 12px;
  line-height: 1.7;
}

.back {
  display: block;
  text-align: center;
  color: #75bcff;
  text-decoration: none;
  margin: 20px;
}

@media(max-width: 450px) {
  .container {
    padding: 12px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">MEDIAX</div>
  <div>Video Preview & Download</div>
</header>

<main class="container">

<section class="card">

  <h1>Video Downloader</h1>

  <p class="description">
    Paste a direct video file link to check and preview
    supported videos.
  </p>

  <form id="mediaForm">

    <label for="mediaUrl">Paste Video URL</label>

    <input
      id="mediaUrl"
      type="url"
      placeholder="https://example.com/video.mp4"
      maxlength="2048"
      required
    >

    <button
      class="main-button"
      id="checkButton"
      type="submit"
    >
      Check Video
    </button>

  </form>

  <div id="status" role="status" aria-live="polite"></div>

  <div class="preview" id="preview"></div>

  <a
    id="downloadButton"
    class="download-button"
    href="#"
    target="_blank"
    rel="noopener noreferrer"
  >
    Open / Download Video
  </a>

</section>

<section class="card">

  <h2>Important Information</h2>

  <p class="note">
    MEDIAX currently checks direct video file links such as
    MP4, WebM, MOV and M4V.

    The source website controls whether a video can actually
    be downloaded. Some websites may block previews or
    downloads.

    Only download videos you own or have permission to use.
    This website does not bypass login restrictions,
    privacy controls or DRM.
  </p>

</section>

<a class="back" href="./index.html">← Back to Home</a>

</main>

<script>
const API_URL = "https://mediax-api.onrender.com";

const form = document.getElementById("mediaForm");
const input = document.getElementById("mediaUrl");
const button = document.getElementById("checkButton");
const statusBox = document.getElementById("status");
const preview = document.getElementById("preview");
const downloadButton = document.getElementById("downloadButton");

function showStatus(message, success = false) {
  statusBox.textContent = message;
  statusBox.style.color = success ? "#6ee7a8" : "#ff9b9b";
}

function clearResults() {
  preview.replaceChildren();
  preview.style.display = "none";

  downloadButton.style.display = "none";
  downloadButton.href = "#";
}

function showVideo(url) {
  const heading = document.createElement("h3");
  heading.textContent = "Video Preview";

  const video = document.createElement("video");

  video.src = url;
  video.controls = true;
  video.preload = "metadata";
  video.playsInline = true;

  video.addEventListener("error", () => {
    showStatus(
      "Video link recognized, but the source does not allow browser preview."
    );
  });

  preview.append(heading, video);
  preview.style.display = "block";
}

form.addEventListener("submit", async event => {
  event.preventDefault();

  clearResults();

  button.disabled = true;
  button.textContent = "Checking...";

  showStatus("Checking video link...", true);

  try {
    const enteredUrl = input.value.trim();

    const response = await fetch(
      API_URL + "/api/media/inspect",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          url: enteredUrl
        })
      }
    );

    const data = await response.json();

    if (!response.ok || !data.success) {
      throw new Error(
        data.message || "Video link could not be checked."
      );
    }

    if (data.mediaType !== "video") {
      throw new Error("Please provide a direct video file link.");
    }

    const safeUrl = new URL(data.previewUrl);

    if (safeUrl.protocol !== "https:") {
      throw new Error("Only HTTPS video links are supported.");
    }

    showVideo(safeUrl.href);

    showStatus(
      "Video link recognized. Checking download link...",
      true
    );

    const downloadResponse = await fetch(
      API_URL + "/api/media/download-check",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          url: safeUrl.href
        })
      }
    );

    const downloadData = await downloadResponse.json();

    if (!downloadResponse.ok || !downloadData.success) {
      throw new Error(
        downloadData.message || "Download link unavailable."
      );
    }

    const downloadUrl = new URL(downloadData.downloadUrl);

    if (downloadUrl.protocol !== "https:") {
      throw new Error("Unsafe download link.");
    }

    downloadButton.href = downloadUrl.href;
    downloadButton.style.display = "block";

    showStatus(
      "Video recognized! Use the button below. Actual downloading depends on source permissions.",
      true
    );

  } catch (error) {
    showStatus(
      error.message || "Unable to check this video."
    );
  } finally {
    button.disabled = false;
    button.textContent = "Check Video";
  }
});
</script>

</body>
</html>
